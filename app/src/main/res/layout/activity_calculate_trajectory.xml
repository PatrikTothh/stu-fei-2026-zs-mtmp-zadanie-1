<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9F7"
    android:fillViewport="true"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    tools:context=".CalculateTrajectory">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="40dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <TextView
            android:id="@+id/titleTrajectory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Trajectory Calculator"
            android:textColor="#183326"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Input section -->
        <TextView
            android:id="@+id/inputSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="INPUT PARAMETERS"
            android:textColor="#78877D"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titleTrajectory" />

        <EditText
            android:id="@+id/editTextInitialVelocity"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:background="#FFFFFF"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="Initial velocity (m/s)"
            android:inputType="numberDecimal|numberSigned"
            android:singleLine="true"
            android:textColor="#183326"
            android:textColorHint="#929E95"
            android:textSize="16sp"
            android:elevation="1dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/inputSectionTitle" />

        <EditText
            android:id="@+id/editTextAngle"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:background="#FFFFFF"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="Angle (degrees)"
            android:inputType="numberDecimal|numberSigned"
            android:singleLine="true"
            android:textColor="#183326"
            android:textColorHint="#929E95"
            android:textSize="16sp"
            android:elevation="1dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/editTextInitialVelocity" />

        <!-- Primary green button -->
        <Button
            android:id="@+id/buttonCalculate"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:text="Calculate Trajectory"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#218653"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="14dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/editTextAngle" />

        <!-- Results section -->
        <TextView
            android:id="@+id/resultsSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="EXPLORE RESULTS"
            android:textColor="#78877D"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonCalculate" />

        <Button
            android:id="@+id/buttonList"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:text="List Data"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textColor="#216641"
            android:backgroundTint="#E1F1E6"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/resultsSectionTitle" />

        <Button
            android:id="@+id/buttonGraph"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="Show Graph"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textColor="#216641"
            android:backgroundTint="#E1F1E6"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonList" />

        <Button
            android:id="@+id/buttonAnimation"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="Show Animation"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textColor="#216641"
            android:backgroundTint="#E1F1E6"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonGraph" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>