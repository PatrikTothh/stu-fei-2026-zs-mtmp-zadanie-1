<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9F7"
    android:fillViewport="true"
    android:padding="24dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/titleTrajectory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Trajectory Calculator"
            android:textColor="#183326"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/inputSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="INPUT PARAMETERS"
            android:textColor="#78877D"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/titleTrajectory"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/editTextInitialVelocity"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:background="#FFFFFF"
            android:paddingHorizontal="16dp"
            android:hint="Initial velocity (m/s)"
            android:inputType="numberDecimal|numberSigned"
            android:singleLine="true"
            android:textColor="#183326"
            android:textColorHint="#929E95"
            app:layout_constraintTop_toBottomOf="@id/inputSectionTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/editTextAngle"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:background="#FFFFFF"
            android:paddingHorizontal="16dp"
            android:hint="Angle (degrees)"
            android:inputType="numberDecimal|numberSigned"
            android:singleLine="true"
            android:textColor="#183326"
            android:textColorHint="#929E95"
            app:layout_constraintTop_toBottomOf="@id/editTextInitialVelocity"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/buttonCalculate"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:text="Calculate Trajectory"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#218653"
            app:cornerRadius="14dp"
            app:layout_constraintTop_toBottomOf="@id/editTextAngle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/resultsSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="EXPLORE RESULTS"
            android:textColor="#78877D"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/buttonCalculate"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/buttonList"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:text="List Data"
            android:textAllCaps="false"
            android:textColor="#216641"
            android:backgroundTint="#E1F1E6"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/resultsSectionTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/buttonGraph"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="Show Graph"
            android:textAllCaps="false"
            android:textColor="#216641"
            android:backgroundTint="#E1F1E6"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/buttonList"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/buttonAnimation"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="Show Animation"
            android:textAllCaps="false"
            android:textColor="#216641"
            android:backgroundTint="#E1F1E6"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/buttonGraph"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>