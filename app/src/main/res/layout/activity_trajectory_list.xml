<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9F7"
    android:padding="24dp">

    <TextView
        android:id="@+id/textViewListHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Trajectory Data"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#183326"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textViewListSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Time, X, Y coordinates"
        android:textSize="14sp"
        android:textColor="#78877D"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/textViewListHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ListView
        android:id="@+id/listViewTrajectory"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:background="#FFFFFF"
        android:divider="#E5ECE6"
        android:dividerHeight="1dp"
        android:padding="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/textViewListSubtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>